# Metroskool Monitor web — copy to `.env.local` (gitignored).
# Never put service-role keys in NEXT_PUBLIC_* variables.
# This app talks to Monitor RPCs with the anon key + teacher JWT. No service role.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3004
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

METROSKOOL_APP_ENV=local
