{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metroskool Monitor",
  "version": "0.1.0",
  "identifier": "com.altrastate.metroskool.monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Metroskool Monitor",
        "width": 720,
        "height": 840
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"]
  }
}
